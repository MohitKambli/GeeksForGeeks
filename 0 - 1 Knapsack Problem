class Solution {
    static int helper(int index, int n, int w, int[] wt, int[] val, int[][] dp) {
        if(index < 0)
            return 0;
        if(dp[index][w] != -1)
            return dp[index][w];
        
        int notPick = helper(index-1, n, w, wt, val, dp);
        int pick = 0;
        if(wt[index] <= w)
            pick = val[index] + helper(index-1, n, w-wt[index], wt, val, dp);
        return dp[index][w] = Math.max(pick, notPick);
    }
    // Function to return max value that can be put in knapsack of capacity W.
    static int knapSack(int W, int wt[], int val[]) {
        int n = val.length;
        int[][] dp = new int[n][W+1];
        for(int[] arr : dp)
            Arrays.fill(arr, -1);
        return helper(n-1, n, W, wt, val, dp);
    }
}
