class Solution {
    public int helper(int i, int j, String s, String t, int[][] dp) {
        if(i < 0)
            return j+1;
        if(j < 0)
            return i+1;
        if(dp[i][j] != -1)
            return dp[i][j];
        
        if(s.charAt(i) == t.charAt(j))
            return dp[i][j] = helper(i-1, j-1, s, t, dp);
        return dp[i][j] = 1 + Math.min(
            helper(i-1, j-1, s, t, dp),
            Math.min(
                helper(i-1, j, s, t, dp),
                helper(i, j-1, s, t, dp)
            )
        );
    }
    public int editDistance(String str1, String str2) {
        int m = str1.length(), n = str2.length();
        int[][] dp = new int[m][n];
        for(int[] arr : dp)
            Arrays.fill(arr, -1);
        return helper(m-1, n-1, str1, str2, dp);
    }
}
