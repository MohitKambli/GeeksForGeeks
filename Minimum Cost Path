class Solution
{
    //Function to return the minimum cost to react at bottom
	//right cell from top left cell.
    public int minimumCostPath(int[][] grid)
    {
        // Code here
        int n = grid.length;
        boolean[][] visited = new boolean[n][n];
        visited[0][0] = true;
        PriorityQueue<int[]> heap = new PriorityQueue<>((a, b) -> Integer.compare(a[2], b[2]));
        heap.add(new int[]{0, 0, grid[0][0]});
        int[][] directions = new int[][]{{1,0},{-1,0},{0,1},{0,-1}};
        int[][] ans = new int[n][n];
        for(int[] arr : ans)
            Arrays.fill(arr, Integer.MAX_VALUE);
        ans[0][0] = 0;
        while(!heap.isEmpty()) {
            int[] pair = heap.poll();
            int x = pair[0], y = pair[1], cost = pair[2];
            for(int[] direction : directions) {
                int dx = direction[0], dy = direction[1];
                int newX = x + dx, newY = y + dy;
                if(newX < 0 || newX == n || newY < 0 || newY == n || visited[newX][newY])
                    continue;
                int adjCost = grid[newX][newY];
                if(cost + adjCost < ans[newX][newY]) {
                    ans[newX][newY] = cost + adjCost;
                    visited[newX][newY] = true;
                    heap.add(new int[]{newX, newY, cost + adjCost});
                }
            }
        }
        return ans[n-1][n-1];
    }
}
