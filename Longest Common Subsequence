class Solution {
    static int helper(int i, int j, String s, String t, int[][] dp) {
        if(i < 0 || j < 0)
            return 0;
        if(dp[i][j] != -1)
            return dp[i][j];
        
        if(s.charAt(i) == t.charAt(j))
            return dp[i][j] = 1 + helper(i-1, j-1, s, t, dp);
        return dp[i][j] = Math.max(helper(i-1, j, s, t, dp), helper(i, j-1, s, t, dp));
    }
    // Function to find the length of longest common subsequence in two strings.
    static int lcs(int n, int m, String str1, String str2) {
        int[][] dp = new int[n][m];
        for(int[] arr : dp)
            Arrays.fill(arr, -1);
        return helper(n-1, m-1, str1, str2, dp);
    }
}
