//User function Template for Java

class Solution{
    static int helper(int i, int j, int n, int[][] matrix, int[][] dp) {
        if(j < 0 || j == n)
            return 0;
        if(i == 0)
            return matrix[0][j];
        if(dp[i][j] != -1)
            return dp[i][j];
        
        int upLeft = helper(i-1, j-1, n, matrix, dp);
        int up = helper(i-1, j, n, matrix, dp);
        int upRight = helper(i-1, j+1, n, matrix, dp);
        return dp[i][j] = matrix[i][j] + Math.max(upLeft, Math.max(up, upRight));
    }
    static int maximumPath(int n, int matrix[][])
    {
        int ans = Integer.MIN_VALUE;
        int[][] dp = new int[n][n];
        for(int[] arr : dp)
            Arrays.fill(arr, -1);
        for(int i=0;i<n;i++)
            ans = Math.max(ans, helper(n-1, i, n, matrix, dp));
        return ans;
    }
}
